# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Admin Analytics API and Authentication
VITE_API_BASE_URL="https://meme-capsule-eww.pages.dev"
VITE_ADMIN_PIN="696969"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Monetization: create a REWARDED VIDEO unit in AdMob (not rewarded interstitial).
# Production rewards remain unavailable until this is configured.
VITE_ADMOB_REWARDED_ID=""
# Optional banner placement on the waiting/home screen; empty keeps it disabled.
VITE_ADMOB_BANNER_ID=""
# For local APK verification only. Uses Google's sample ad units, never live ads.
VITE_ADMOB_TEST_MODE="false"
